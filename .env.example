# Postgres no Supabase (projeto rtbduqyfuleowcriexhg).
# Painel → Project Settings → Database → Connection string:
#  - DATABASE_URL: "Transaction pooler" (porta 6543) — usado pelo app na Vercel.
#  - DIRECT_URL:   "Session pooler" (porta 5432) ou conexão direta — usado só pelo `npm run db:migrate`.
# Substitua [YOUR-PASSWORD] pela senha do banco (nunca commite este arquivo preenchido).
DATABASE_URL=postgresql://postgres.rtbduqyfuleowcriexhg:[YOUR-PASSWORD]@aws-0-REGIAO.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.rtbduqyfuleowcriexhg:[YOUR-PASSWORD]@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Auth.js
AUTH_SECRET=gere-com-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic link (Resend)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Aposentadoria <login@seudominio.com>"
