# Postgres no Supabase.
# Painel → Connect → Connection string:
#  - DATABASE_URL: "Transaction pooler" (porta 6543) — usado pelo app (inclusive na Vercel).
#  - DIRECT_URL:   "Session pooler" (porta 5432) — usado só pelo `npm run db:migrate`.
# Nunca commite este arquivo preenchido: copie para .env (que está no .gitignore).
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-1-SUA-REGIAO.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-1-SUA-REGIAO.pooler.supabase.com:5432/postgres

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic link (Resend)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Aposentadoria <voce@seudominio.com>"
